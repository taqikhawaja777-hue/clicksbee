SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
CORS_ORIGINS=http://localhost:5173
PORT=8000

# Jibble sync (optional - leave blank to run without Jibble; the sync
# scheduler simply won't start). Get these from Jibble's Organization
# Settings > API Keys.
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=
# Only needed if your Jibble endpoints are scoped under /organizations/{id}/...
JIBBLE_ORGANIZATION_ID=
JIBBLE_SYNC_INTERVAL_MINUTES=5
