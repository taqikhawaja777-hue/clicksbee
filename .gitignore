# Environment and credentials
.env
.env.*
!.env.example
# Not a secret - just the production build's public server URLs, baked into
# the renderer bundle at build time and shipped inside the packaged app
# regardless (see admin_dashboard/.env.production's own header comment).
!admin_dashboard/.env.production

# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
admin_dashboard/release*/
admin_dashboard/dist-installer*/
admin_dashboard/.electron-dist/
.vite/
coverage/
admin_dashboard/build_dist/

# Runtime data
backend/storage/

# Logs and editor files
*.log
.vscode/
*.tsbuildinfo

# Python (productivity_service)
__pycache__/
*.pyc
.pytest_cache/
.venv/
