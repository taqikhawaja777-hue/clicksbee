# Baked into the renderer bundle at build time by Vite (npm run build:renderer
# / npm run build / npm run build:win) - NOT read at runtime, so these are
# fixed once a version is built. Must match serverConfig.ts's production
# URLs (main-process code) and render.yaml's service names (these ARE those
# services' real URLs once deployed on Render).
#
# Plain server URLs only - no secrets belong in this file. It's committed to
# git and ships inside the packaged app, which every employee can inspect.
VITE_API_BASE_URL=https://clicksbee-backend.onrender.com/api/v1
VITE_SOCKET_URL=https://clicksbee-backend.onrender.com
VITE_PRODUCTIVITY_API_URL=https://clicksbee-productivity.onrender.com
