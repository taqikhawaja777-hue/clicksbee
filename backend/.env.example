# Database Configuration (MongoDB Atlas or local MongoDB)
# Replace this with your own connection string. Do not commit real credentials.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/stitchmonitor?retryWrites=true&w=majority"

# JWT Auth Configuration
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

# AI Configuration (optional unless AI analysis features are enabled)
GROQ_API_KEY=""
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"

# Server Configuration
PORT=3000
NODE_ENV="development"
API_PREFIX="api/v1"
FRONTEND_URL="http://localhost:5173"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# Storage Configuration
STORAGE_PATH="./storage"
MAX_FILE_SIZE=10485760

# Monitoring Retention
SCREENSHOT_RETENTION_DAYS=30
ACTIVITY_RETENTION_DAYS=90
